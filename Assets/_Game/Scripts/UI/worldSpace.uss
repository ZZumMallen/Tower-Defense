:root {
}

.health-bar-root {
    position: relative;
    width: 200px;
    height: 35px;
}

.health-bar-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(45, 24, 24);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.health-bar-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(45, 190, 70);
}

.health-bar-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: white;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
}
