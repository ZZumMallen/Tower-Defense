:root {
}

.unity-button {
    margin-top: 8px;
    margin-right: 2px;
    margin-left: 2px;
    width: 150px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(226, 149, 68);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.unity-label {
}

.unity-button:hover {
    margin-top: 8px;
    margin-right: 2px;
    margin-left: 2px;
    width: 150px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(236, 171, 101);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.unity-button:active {
    margin-top: 8px;
    margin-right: 2px;
    margin-left: 2px;
    width: 150px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(224, 200, 174);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-top-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    scale: 1 1;
}
